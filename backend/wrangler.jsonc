{
  "name": "aquipay-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://aquipay.isabstudio.dev",
    "EXTRA_ORIGINS": "https://jolly-base-3c89.osamariches.workers.dev,https://localhost,capacitor://localhost,http://localhost",
    "MAIL_FROM": "no-reply@isabstudio.dev",
    "GOOGLE_PLAY_PACKAGE_NAME": "com.aquipay.isabstudio",
    "GOOGLE_PLAY_COIN_PRODUCTS": "{\"coins_10\":{\"coins\":10,\"bonus\":0},\"coins_50\":{\"coins\":50,\"bonus\":0},\"coins_110\":{\"coins\":110,\"bonus\":10},\"coins_240\":{\"coins\":240,\"bonus\":40},\"coins_650\":{\"coins\":650,\"bonus\":150}}",
    "VAPID_PUBLIC_KEY": "BH-wW8rBNSru4t4iAiHetwaqYhLpaq59JitYbwYEpYzk9bc4W9vy25QxwFCn5bjlQ12PaO15ufvQS7ivcU_4D6g"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aquipay-db",
      "database_id": "3c9f4023-87eb-4fbe-885b-d25760974c71"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aquipay-blobs"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_ROOMS",
        "class_name": "CallRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-call-room",
      "new_sqlite_classes": [
        "CallRoom"
      ]
    }
  ]
}
